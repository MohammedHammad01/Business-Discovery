# Copy to backend/.env (or export these) before running the backend.
# Never commit the real file. The key stays server-side and is never sent to React.

# Google AI Studio (Gemini). Free key: https://aistudio.google.com/apikey
# Leave empty to run the deterministic mock agent instead of calling a provider.
GEMINI_API_KEY=

# Free-tier models that handle both structured output and vision:
#   gemini-2.5-flash        (default, best quality on the free tier)
#   gemini-2.5-flash-lite   (faster, higher rate limit)
#   gemini-2.0-flash        (older, still free)
GEMINI_MODEL=gemini-2.5-flash

# Set to false to make a missing key a hard error instead of falling back to mock.
ALLOW_MOCK_LLM=true

DATABASE_URL=sqlite:///./app.db

# Limits
MAX_UPLOAD_BYTES=5242880
MAX_SOURCE_CHARS=60000
MAX_TOTAL_CONTENT_CHARS=160000
AI_TIMEOUT_SECONDS=120

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
